# Delta Media Recode — example configuration

PORT=3000
HOST=0.0.0.0

# sqlite | postgres
DB_DRIVER=sqlite
DB_PATH=./delta_v2.db
SUPABASE_DB_URL=

# Код первого админа (создаётся при пустой БД)
ADMIN_BOOTSTRAP_CODE=DELTA-ROOT-0001
SESSION_TTL_HOURS=168
GPS_REQUIRED=true
# ТОЛЬКО локальная разработка (запрещён с postgres): 2FA подтверждается без Telegram
DEV_AUTO_APPROVE_2FA=false

TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CONTACT=notyxx
TELEGRAM_OWNER_IDS=
TELEGRAM_SECRETARY_CONTACT=notyxs

CRYPTOBOT_API_TOKEN=
CRYPTOBOT_TESTNET=false
CRYPTOBOT_ASSET=USDT

WEEK_TZ=Europe/Moscow

UPLOAD_DIR=./uploads
MAX_UPLOAD_GB=2

TURNSTILE_SITEKEY=1x00000000000000000000AA
TURNSTILE_SECRET=
