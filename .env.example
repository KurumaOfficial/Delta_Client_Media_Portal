# Server Port
PORT=3000

# Database File Path
DB_PATH=./delta.db

# Admin Secret Code / Password for Admin Panel (Ctrl+Shift+A)
ADMIN_SECRET=admin123

# Default Moderator Key / Secret
MOD_SECRET=mod123

# Uploads Storage Directory
UPLOAD_DIR=./web/uploads

# Telegram Integration (Telegram Bot API & Business Connection API)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ADMIN_CHAT_ID=your_admin_chat_id_here
TELEGRAM_BUSINESS_CONNECTION_ID=optional_business_connection_id

# Memory Optimization Tuning (Set true for aggressive GC & minimal memory footprint)
GC_TUNING=true
